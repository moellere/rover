# Copy to ~/.rover-brain.env and fill in. Nothing here belongs in git.
ROVER_HOST=            # rover's IP or mDNS name
ROVER_API_KEY=         # base64 ESPHome native-API key (from the private ESPHome secrets)
ROVER_CAM_HOST=        # T-Camera IP (snapshot server on :8081)
BENCH_CAM_HOST=        # workbench camera behind the rover (camv3) IP
FRONT_CAM_HOST=        # head-on camera across the bench (fishcam) IP
FRONT_CAM_USER=root
FRONT_CAM_PASS=
BENCH_CAM_USER=root
BENCH_CAM_PASS=        # or export BENCH_CAM_ONVIF_PASS in ~/.env and map it here
BENCH_CAM_FOCAL_PX=    # from calibration: side_px * distance_mm / 80 (see brain/markers.py)
ROVER_CAM_FOCAL_PX=    # same, once the rover camera is mounted
# The Eufy's lid board (blackcam today): IR commands + its camera
EUFY_HOST=             # lid board IP
EUFY_API_KEY=          # its native-API key (defaults to ROVER_API_KEY)
EUFY_CAM_HOST=         # camera on the lid
EUFY_CAM_KIND=esphome  # esphome (T-Camera, :8081) or thingino (camv3)
EUFY_CAM_USER=root     # thingino only
EUFY_CAM_PASS=         # thingino only
# Hosting (container): BRAIN_TRANSPORT=http BRAIN_HOST=0.0.0.0 BRAIN_PORT=8000
