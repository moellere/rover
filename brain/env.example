# Copy to ~/.rover-brain.env and fill in. Nothing here belongs in git.
ROVER_HOST=            # rover's IP or mDNS name
ROVER_API_KEY=         # base64 ESPHome native-API key (from the private ESPHome secrets)
ROVER_CAM_HOST=        # T-Camera IP (snapshot server on :8081)
BENCH_CAM_HOST=        # workbench ONVIF camera IP
BENCH_CAM_USER=root
BENCH_CAM_PASS=        # or export BENCH_CAM_ONVIF_PASS in ~/.env and map it here
